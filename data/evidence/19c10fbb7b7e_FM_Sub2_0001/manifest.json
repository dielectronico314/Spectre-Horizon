        "fft": {
            "_schema": "cenital/spectrogram-config@1",
            "_doc": {
                "escala": "dBFS normalizado por RBW. P = |FFT(x*w)|^2 / (sum(w))^2. Un tono CW complejo a fondo de escala y centrado en bin lee 0.0 dBFS. El piso de ruido lee dBFS POR RBW; sin declarar RBW ese numero no significa nada. Para densidad: dBFS/Hz = dBFS - 10*log10(rbw_hz).",
                "fondo_de_escala": "Derivado de core:datatype (ci16_le -> /32768). No se hardcodea el ancho de bits.",
                "relaciones": "df = fs/nfft | RBW = ENBW_bins*df | dt_trama = nfft/fs | hop = nfft*(1-overlap)",
                "enbw_bins": "boxcar 1.00 | hann 1.50 | hamming 1.36 | blackmanharris 2.00 | flattop 3.77 | kaiser(beta) variable",
                "elegir_nfft": "Se deriva del RBW objetivo: nfft = ENBW_bins*fs/RBW_objetivo. No es un default.",
                "elegir_ventana": "hann = PSD generica. flattop = medir amplitud de CW de frecuencia desconocida (scalloping <0.05 dB vs 1.42 dB de hann). blackmanharris = senal debil junto a una fuerte (rango dinamico). boxcar = pulsos aislados / maxima resolucion temporal."
            },
            "fft": {
                "nfft": 1024,
                "window": "hann",
                "window_arg": null,
                "overlap": 0.5,
                "remove_dc": false,
                "max_seconds": null
            },
            "calibration": {
                "cal_offset_db": 0.0,
                "_doc": "Offset constante dBFS -> dBm. Requiere reference level del Harogic y el factor de escala a volts del paquete. Mientras sea 0.0 la salida es honestamente relativa a fondo de escala, no absoluta."
            },
            "output": {
                "png_max_cols": 1600,
                "png_time_reduction": "maxhold",
                "png_vmin_percentile": 5.0,
                "png_vmax_percentile": 99.95,
                "png_cmap": "viridis",
                "png_dpi": 110,
                "_doc": "png_time_reduction=maxhold es deliberado: si hay mas tramas que pixeles, matplotlib submuestrea por vecino mas cercano y descarta los transitorios que el overlap del 50% pago. maxhold conserva el pico de cada grupo. Usa 'mean' solo para estimar piso de ruido."
